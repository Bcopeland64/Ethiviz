# Copy to .env before `docker compose up` — see docker-compose.yml.

# Required: Postgres password for the `ethiviz` DB user (Upgrade 48).
POSTGRES_PASSWORD=change-me-to-something-random

# Empty by default (Upgrade 40) — every route is reachable without a key.
# Set this before exposing the stack beyond localhost. Comma-separated for
# multiple keys.
ETHIVIZ_API_KEYS=

# Origins allowed to call the API cross-origin (Upgrade 42's CORS config).
# The default matches ETHIVIZ_HTTP_PORT below.
ETHIVIZ_ALLOWED_ORIGINS=http://localhost:8080

# Host port the `frontend` (nginx) service is published on.
ETHIVIZ_HTTP_PORT=8080
